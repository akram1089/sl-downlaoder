# Public
DOMAIN=download.spikeiq.cloud
PUBLIC_URL=https://download.spikeiq.cloud
NEXT_PUBLIC_API_URL=https://download.spikeiq.cloud/api
NEXT_PUBLIC_WS_URL=wss://download.spikeiq.cloud/api/ws

# Secrets (generate strong values for production)
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_ENCRYPTION_KEY=change-me-32-byte-base64-or-hex
POSTGRES_USER=streamline
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=streamline
DATABASE_URL=postgresql+asyncpg://streamline:change-me-db-password@postgres:5432/streamline
REDIS_URL=redis://redis:6379/0

# App
ADMIN_EMAIL=admin@spikeiq.cloud
ADMIN_PASSWORD=change-me-admin-password
MAX_CONCURRENT_DOWNLOADS=2
RETENTION_HOURS=72
DOWNLOAD_DIR=/data/downloads
COOKIES_DIR=/data/cookies
DEFAULT_COOKIES_FILE=/data/cookies/youtube.txt
YOUTUBE_PLAYER_CLIENTS=web,mweb,tv,android
CORS_ORIGINS=https://download.spikeiq.cloud,http://localhost:3000

# VPS deploy credentials (local only — never commit)
# kvm4_ip=
# kvm4_pass=
